{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TST Test Case",
  "description": "Test case. Must trace to at least one SWR (enforced by scripts/validate_iso26262.py).",
  "type": "object",
  "required": ["uid", "level", "text", "header", "status", "links"],
  "properties": {
    "uid": {"type": "string", "pattern": "^[A-Z]{3}[0-9]{3,}$"},
    "level": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "header": {"type": "string", "minLength": 3},
    "text": {"type": "string", "minLength": 20, "pattern": "\\S"},
    "status": {"type": "string", "enum": ["draft", "reviewed", "approved", "obsolete"]},
    "links": {"type": "array", "minItems": 1}
  }
}
