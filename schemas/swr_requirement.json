{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SWR Requirement",
  "description": "Software requirement. Must trace to at least one SRD (enforced by scripts/validate_iso26262.py).",
  "type": "object",
  "required": ["uid", "level", "text", "header", "status", "links"],
  "properties": {
    "uid": {"type": "string", "pattern": "^[A-Z]{3}[0-9]{3,}$"},
    "level": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
    "header": {"type": "string", "minLength": 3},
    "text": {"type": "string", "pattern": "^The (system|software) shall\\b", "minLength": 20},
    "status": {"type": "string", "enum": ["draft", "reviewed", "approved", "obsolete"]},
    "asil": {"type": "string", "enum": ["QM", "A", "B", "C", "D"]},
    "rationale": {"type": "string", "pattern": "\\S"},
    "links": {"type": "array", "minItems": 1}
  }
}
