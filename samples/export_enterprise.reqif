      <VALUES>
        <ATTRIBUTE-VALUE-INTEGER THE-VALUE="20"><DEFINITION><ATTRIBUTE-DEFINITION-INTEGER-REF>ad-foreignid</ATTRIBUTE-DEFINITION-INTEGER-REF></DEFINITION></ATTRIBUTE-VALUE-INTEGER>
        <ATTRIBUTE-VALUE-STRING THE-VALUE="Časový limit relácie"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ad-name</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
