        <ATTRIBUTE-VALUE-DATE THE-VALUE="2026-10-15T00:00:00.000+02:00"><DEFINITION><ATTRIBUTE-DEFINITION-DATE-REF>ad-reviewed</ATTRIBUTE-DEFINITION-DATE-REF></DEFINITION></ATTRIBUTE-VALUE-DATE>
