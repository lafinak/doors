      <VALUES>
        <ATTRIBUTE-VALUE-INTEGER THE-VALUE="12"><DEFINITION><ATTRIBUTE-DEFINITION-INTEGER-REF>ad-foreignid</ATTRIBUTE-DEFINITION-INTEGER-REF></DEFINITION></ATTRIBUTE-VALUE-INTEGER>
        <ATTRIBUTE-VALUE-STRING THE-VALUE="Záznam udalostí"><DEFINITION><ATTRIBUTE-DEFINITION-STRING-REF>ad-name</ATTRIBUTE-DEFINITION-STRING-REF></DEFINITION></ATTRIBUTE-VALUE-STRING>
